---
import '../styles/global.css';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
const fullTitle = title ? `${title} — ${site.nom}` : site.nom;
const desc = description ?? site.slogan;

const pagesMenu = (await getCollection('pages', (p) => p.data.publie && p.data.afficher_menu))
  .sort((a, b) => a.data.ordre_menu - b.data.ordre_menu);

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/vehicules', label: 'Nos Renault 5' },
  { href: '/documentation', label: 'Documentation' },
  { href: '/sorties', label: 'Rencontres & sorties' },
  { href: '/association', label: "L'association" },
  ...pagesMenu.map((p) => ({ href: `/${p.slug}`, label: p.data.title })),
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap header-in">
       <a class="logo" href="/" aria-label={`${site.nom} — accueil`}>
          <img class="logo-img" src="/images/logoair5bleu.png" alt="" height="56" />
          <span>{site.nom}</span>
      </a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Ouvrir le menu" />
        <label for="menu-toggle" class="burger" aria-hidden="true"><span></span></label>
        <nav aria-label="Navigation principale">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a class="btn btn-small" href="/adhesion">Adhérer</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot-in">
        <div>
          <strong>{site.nom}</strong>
          <p>{site.adresse}</p>
        </div>
        <div>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p>
            {site.facebook && <a href={site.facebook} rel="noopener">Facebook</a>}
            {site.facebook && site.instagram && ' · '}
            {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
