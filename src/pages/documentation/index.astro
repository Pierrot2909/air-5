---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const docs = (await getCollection('documents', (d) => d.data.publie));
const cats = [...new Set(docs.map((d) => d.data.categorie))].sort((a, b) => a.localeCompare(b, 'fr'));
---
<Base title="Documentation et sites internet utiles et de pièces" description="Documentation technique Renault 5 et Supercinq : manuels , sites de pièces, conseils.">
  <div class="wrap page-head">
    <div class="titre-img">
      <img src="/images/atelier-illustration.jpg" alt="" width="88" height="88" />
      <h1>Documentation technique</h1>
    </div>
    <p class="muted">Documentation technique Renault 5 et Supercinq : manuels , sites de pièces, conseils. Tout pour entretenir ou restaurer votre Renault 5 ou votre Supercinq.</p>
    {cats.map((c) => (
      <section>
        <h2>{c}</h2>
        <ul class="doc-list">
          {docs.filter((d) => d.data.categorie === c).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr')).map((d) => (
            <li class="doc">
              <div>
                <h3>{d.data.title}</h3>
                {d.data.description && <p class="muted">{d.data.description}</p>}
              </div>
              {d.data.fichier
                ? <a class="btn btn-small" href={d.data.fichier} download>Télécharger</a>
                : d.data.lien
                  ? <a class="btn btn-small" href={d.data.lien} rel="noopener">Consulter</a>
                  : <a class="btn btn-small" href={`/documentation/${d.slug}`}>Lire</a>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .titre-img{display:flex;align-items:center;gap:1rem;margin-bottom:.6rem}
  .titre-img img{width:88px;height:88px;border-radius:14px;object-fit:cover;flex:none}
  .titre-img h1{margin:0}
</style>
